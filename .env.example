# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real keys/tokens.

# Odds data (The Odds API: https://the-odds-api.com). Either name works;
# bot/odds_fetcher.py checks THE_ODDS_API_KEY first, then falls back to
# SPORTSBOOK_ODDS_API_KEY. Required for run_odds_fetch.py and anything
# downstream of it (market comparison, alerts, bet candidate export).
THE_ODDS_API_KEY=

# Optional: caps for player-props odds fetches (run_player_props.py /
# run_mlb_player_props.py). Sensible defaults are used if unset.
PLAYER_PROPS_MAX_AGE_MINUTES=
PLAYER_PROPS_MAX_EVENTS=
MLB_PLAYER_PROPS_MAX_AGE_MINUTES=
MLB_PLAYER_PROPS_MAX_EVENTS=

# Optional: enables run_ai_advisor.py to call the OpenAI Responses API
# instead of writing a local rules-based advisor report.
OPENAI_API_KEY=
OPENAI_MODEL=

# SharpAPI (https://sharpapi.io) -- an alternative odds source to The Odds
# API. Not wired into bot/odds_fetcher.py yet as of this line being added;
# the two providers return differently-shaped JSON (nested bookmakers/
# markets/outcomes vs. SharpAPI's flat per-row odds), so having the key set
# alone does not make anything use it. See sports/sharpapi_odds.py (once it
# exists) for the actual integration.
SHARPAPI_API_KEY=

# Only used by scripts in legacy/ (not part of the current documented
# pipeline -- see legacy/README.md).
SPORTSBOOK_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
