# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real keys/tokens.

# Odds data (SharpAPI: https://sharpapi.io) -- the sole odds provider for
# run_odds_fetch.py and everything downstream of it (market comparison,
# alerts, bet candidate export). Required.
#
# The Odds API was used here previously but was removed: its free-tier
# quota (500 requests/month) ran out under this pipeline's normal call
# volume, and every failure was silently falling back to SharpAPI anyway --
# so SharpAPI alone is now the whole story, not a fallback for something
# else. THE_ODDS_API_KEY/SPORTSBOOK_ODDS_API_KEY are no longer read by
# anything in this pipeline if you still have them set.
SHARPAPI_API_KEY=

# Optional: caps for player-props odds fetches (run_player_props.py /
# run_mlb_player_props.py). Sensible defaults are used if unset.
PLAYER_PROPS_MAX_AGE_MINUTES=
PLAYER_PROPS_MAX_EVENTS=
MLB_PLAYER_PROPS_MAX_AGE_MINUTES=
MLB_PLAYER_PROPS_MAX_EVENTS=

# Optional: enables run_ai_advisor.py to call the OpenAI Responses API
# instead of writing a local rules-based advisor report.
OPENAI_API_KEY=
OPENAI_MODEL=

# Only used by scripts in legacy/ (not part of the current documented
# pipeline -- see legacy/README.md).
SPORTSBOOK_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
